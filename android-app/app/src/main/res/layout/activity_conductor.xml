<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_primary"
        style="@style/Widget.BusCrowd.Toolbar" />

    <!-- Offline Banner -->
    <TextView
        android:id="@+id/tv_offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/crowd_few_bg"
        android:textColor="@color/crowd_few"
        android:textStyle="bold"
        android:textSize="13sp"
        android:padding="12dp"
        android:gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- LIVE HUD CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡 LIVE BUS CROWD HUD"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"
                    android:letterSpacing="0.05" />

                <ProgressBar
                    android:id="@+id/pb_conductor_crowd"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/crowd_meter_progress"
                    style="?android:attr/progressBarStyleHorizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Onboard"
                            style="@style/TextStyle.BusCrowd.Label" />

                        <TextView
                            android:id="@+id/tv_conductor_onboard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Seats Remaining"
                            style="@style/TextStyle.BusCrowd.Label" />

                        <TextView
                            android:id="@+id/tv_conductor_seats_free"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/crowd_plenty" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_conductor_crowd_band"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="✅ Plenty"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/crowd_plenty"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- ISSUE TICKET CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Issue Passenger Ticket"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <!-- Boarding -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/from_stop"
                    style="@style/TextStyle.BusCrowd.Label"
                    android:layout_marginTop="16dp" />

                <Spinner
                    android:id="@+id/spinner_boarding"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginTop="4dp"
                    android:paddingStart="12dp" />

                <!-- Destination -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/to_stop"
                    style="@style/TextStyle.BusCrowd.Label"
                    android:layout_marginTop="14dp" />

                <Spinner
                    android:id="@+id/spinner_dest"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginTop="4dp"
                    android:paddingStart="12dp" />

                <!-- Passenger count + Fare -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/passenger_count"
                            style="@style/TextStyle.BusCrowd.Label" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_input"
                            android:layout_marginTop="4dp">

                            <ImageButton
                                android:id="@+id/btn_minus"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@android:drawable/ic_input_delete"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:tint="@color/brand_primary"
                                android:contentDescription="Decrease" />

                            <TextView
                                android:id="@+id/tv_passenger_count"
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:gravity="center" />

                            <ImageButton
                                android:id="@+id/btn_plus"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@android:drawable/ic_input_add"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:tint="@color/brand_primary"
                                android:contentDescription="Increase" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end"
                        android:layout_marginStart="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_fare"
                            style="@style/TextStyle.BusCrowd.Label" />

                        <TextView
                            android:id="@+id/tv_conductor_fare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$1.50"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Issue Ticket Button -->
                <Button
                    android:id="@+id/btn_issue_ticket"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ISSUE TICKET"
                    android:textSize="16sp"
                    android:layout_marginTop="24dp" />

                <!-- Sync Button -->
                <Button
                    android:id="@+id/btn_sync_offline"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Sync Offline Queue"
                    android:backgroundTint="@color/bg_light"
                    android:textColor="@color/crowd_few"
                    android:layout_marginTop="8dp" />

                <!-- Reset Trip Button -->
                <Button
                    android:id="@+id/btn_reset_trip"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🔄 RESET BUS FOR NEW TRIP (0 ONBOARD)"
                    android:backgroundTint="#FFF0F0"
                    android:textColor="@color/crowd_full"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
