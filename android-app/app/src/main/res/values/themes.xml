<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.BusCrowd" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/bg_white</item>
        <item name="android:fontFamily">sans-serif</item>

        <!-- Button style -->
        <item name="materialButtonStyle">@style/Widget.BusCrowd.Button</item>
    </style>

    <!-- Splash theme (solid brand color background) -->
    <style name="Theme.BusCrowd.Splash" parent="Theme.BusCrowd">
        <item name="android:windowBackground">@color/brand_primary</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
    </style>

    <!-- AppBar / Toolbar -->
    <style name="Widget.BusCrowd.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/brand_primary</item>
        <item name="titleTextColor">@color/text_white</item>
        <item name="subtitleTextColor">#B2DFCF</item>
    </style>

    <!-- Primary Button -->
    <style name="Widget.BusCrowd.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Card style -->
    <style name="Widget.BusCrowd.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/bg_white</item>
        <item name="contentPaddingLeft">16dp</item>
        <item name="contentPaddingRight">16dp</item>
        <item name="contentPaddingTop">16dp</item>
        <item name="contentPaddingBottom">16dp</item>
    </style>

    <!-- Text styles -->
    <style name="TextStyle.BusCrowd" parent="" />

    <style name="TextStyle.BusCrowd.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextStyle.BusCrowd.Subtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextStyle.BusCrowd.Label">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextStyle.BusCrowd.Value">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>
</resources>
